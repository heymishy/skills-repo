{
  "name": "@heymishy/skills-repo",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skills-repo": "cli/bin/init.js"
  },
  "files": [
    "cli/",
    "scripts/",
    "skills/",
    ".github/skills/",
    ".github/templates/",
    "contexts/personal.yml"
  ],
  "scripts": {
    "start": "node --env-file=.env src/web-ui/server.js",
    "web": "node --env-file=.env src/web-ui/server.js",
    "platform:init": "node scripts/platform-init.js",
    "platform:fetch": "node scripts/platform-fetch.js",
    "platform:pin": "node scripts/platform-pin.js",
    "platform:verify": "node scripts/platform-verify.js",
    "check:sfa1": "node tests/check-sfa1-state-schema.js",
    "test": "node scripts/run-all-tests.js",
    "lint": "node scripts/ci-lint.js",
    "typecheck": "node scripts/ci-typecheck.js",
    "build": "node scripts/ci-build.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy:staging": "node scripts/deploy-staging.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "bcrypt": "^6.0.0",
    "mermaid": "^11.16.0",
    "passport": "^0.7.0",
    "passport-magic-login": "^1.2.4",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "posthog-node": "^5.40.0",
    "resend": "^6.18.1",
    "stripe": "^22.3.0"
  }
}
